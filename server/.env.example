# Application
NODE_ENV=development
PORT=4000
APP_NAME="Ruchi Prativa Foundation"
APP_URL=http://localhost:4000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruchiprativa_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rpf:

# Authentication
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32-chars
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=ruchi-prativa-foundation

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=certificates

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=12

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Ruchi Prativa Foundation <noreply@ruchiprativa.org>"

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE="Ruchi Prativa Foundation API"
SWAGGER_DESCRIPTION="Backend API for Ruchi Prativa Foundation Digital Platform"
SWAGGER_PATH=docs
