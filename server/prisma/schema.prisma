generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shared Enums ────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MEMBER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum IdentityDocumentType {
  AADHAAR
  PAN
  VOTER_ID
  DRIVING_LICENSE
  PASSPORT
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VolunteerStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum VerificationAction {
  APPROVED
  REJECTED
}

enum EventType {
  AWARD
  CULTURAL
  COMMUNITY
  CSR
  HEALTHCARE
  EDUCATION
  ENVIRONMENT
  SOCIAL
  VOLUNTEER
  WORKSHOP
  OTHER
}

enum EditionStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EditionVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum VenueType {
  INDOOR
  OUTDOOR
  HYBRID
}

enum VenueStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ParticipationStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CertificateType {
  PARTICIPATION
  APPRECIATION
  EXCELLENCE
  SPECIAL
}

enum CertificateStatus {
  DRAFT
  ISSUED
  REVOKED
  EXPIRED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id        String       @id @default(uuid()) @db.Uuid
  email     String       @unique
  name      String
  password  String?
  role      Role         @default(MEMBER)
  status    EntityStatus @default(ACTIVE)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid
  deletedBy String?      @map("deleted_by") @db.Uuid

  verifications    VolunteerVerification[]
  createdEvents    Event[]
  createdEditions  EventEdition[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ─── Volunteer ───────────────────────────────────────────────────────────────

model Volunteer {
  id              String          @id @default(uuid()) @db.Uuid
  volunteerCode   String          @unique @map("volunteer_code")
  firstName       String          @map("first_name")
  lastName        String          @map("last_name")
  email           String          @unique
  phone           String          @unique
  dateOfBirth     DateTime        @map("date_of_birth") @db.Date
  gender          Gender
  bloodGroup      BloodGroup      @default(UNKNOWN) @map("blood_group")
  occupation      String?
  organization    String?
  addressLine1    String          @map("address_line_1")
  addressLine2    String?         @map("address_line_2")
  city            String
  state           String
  pincode         String
  country         String          @default("India")
  profilePhotoKey String?         @map("profile_photo_key")
  emergencyName   String?         @map("emergency_name")
  emergencyPhone  String?         @map("emergency_phone")
  motivation      String?         @db.Text
  skills          String[]        @default([])
  languages       String[]        @default([])
  availableDays   String[]        @default([]) @map("available_days")
  volunteerStatus VolunteerStatus @default(PENDING_VERIFICATION) @map("volunteer_status")
  status          EntityStatus    @default(PENDING)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  deletedBy       String?         @map("deleted_by") @db.Uuid

  identities     VolunteerIdentity[]
  verifications  VolunteerVerification[]
  applications   VolunteerApplication[]
  participations VolunteerParticipation[]
  certificates   VolunteerCertificate[]

  @@index([volunteerCode])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([volunteerStatus])
  @@index([city, state])
  @@index([deletedAt])
  @@map("volunteers")
}

// ─── Volunteer Identity ──────────────────────────────────────────────────────

model VolunteerIdentity {
  id                 String                     @id @default(uuid()) @db.Uuid
  volunteerId        String                     @map("volunteer_id") @db.Uuid
  documentType       IdentityDocumentType       @map("document_type")
  documentNumber     String                     @map("document_number")
  documentFileKey    String?                    @map("document_file_key")
  verificationStatus IdentityVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                  @map("verified_at")
  verifiedBy         String?                    @map("verified_by") @db.Uuid
  rejectionReason    String?                    @map("rejection_reason")
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, documentType])
  @@index([volunteerId])
  @@index([documentType])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("volunteer_identities")
}

// ─── Volunteer Verification (Audit Trail) ────────────────────────────────────

model VolunteerVerification {
  id               String             @id @default(uuid()) @db.Uuid
  volunteerId      String             @map("volunteer_id") @db.Uuid
  action           VerificationAction
  previousStatus   VolunteerStatus    @map("previous_status")
  currentStatus    VolunteerStatus    @map("current_status")
  remarks          String?            @db.Text
  verifiedById     String             @map("verified_by_id") @db.Uuid
  verificationDate DateTime           @default(now()) @map("verification_date")
  ipAddress        String?            @map("ip_address")
  userAgent        String?            @map("user_agent") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")

  volunteer  Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  verifiedBy User      @relation(fields: [verifiedById], references: [id])

  @@index([volunteerId])
  @@index([verifiedById])
  @@index([action])
  @@index([verificationDate])
  @@map("volunteer_verifications")
}

// ─── Event (Institutional Program) ──────────────────────────────────────────

model Event {
  id                 String    @id @default(uuid()) @db.Uuid
  eventCode          String    @unique @map("event_code")
  slug               String    @unique
  title              String
  shortDescription   String    @map("short_description") @db.VarChar(500)
  detailedDescription String?  @map("detailed_description") @db.Text
  eventType          EventType @map("event_type")
  logoAssetKey       String?   @map("logo_asset_key")
  defaultBannerKey   String?   @map("default_banner_key")
  primaryColor       String?   @map("primary_color") @db.VarChar(7)
  secondaryColor     String?   @map("secondary_color") @db.VarChar(7)
  themeConfig        Json?     @map("theme_config")
  isRecurring        Boolean   @default(true) @map("is_recurring")
  isActive           Boolean   @default(true) @map("is_active")
  sortOrder          Int       @default(0) @map("sort_order")
  seoTitle           String?   @map("seo_title") @db.VarChar(70)
  seoDescription     String?   @map("seo_description") @db.VarChar(160)
  seoKeywords        String[]  @default([]) @map("seo_keywords")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedBy          String?   @map("deleted_by") @db.Uuid

  createdByUser User?          @relation(fields: [createdById], references: [id])
  editions      EventEdition[]

  @@index([eventCode])
  @@index([slug])
  @@index([eventType])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("events")
}

// ─── Event Edition (Occurrence) ─────────────────────────────────────────────

model EventEdition {
  id                    String           @id @default(uuid()) @db.Uuid
  eventId               String           @map("event_id") @db.Uuid
  editionCode           String           @unique @map("edition_code")
  editionName           String           @map("edition_name")
  year                  Int
  editionNumber         Int              @default(1) @map("edition_number")
  slug                  String           @unique
  theme                 String?
  shortDescription      String           @map("short_description") @db.VarChar(500)
  detailedDescription   String?          @map("detailed_description") @db.Text
  venue                 String
  venueAddress          String?          @map("venue_address") @db.Text
  googleMapsUrl         String?          @map("google_maps_url")
  registrationOpens     DateTime?        @map("registration_opens")
  registrationCloses    DateTime?        @map("registration_closes")
  eventStarts           DateTime         @map("event_starts")
  eventEnds             DateTime         @map("event_ends")
  volunteerCapacity     Int              @default(0) @map("volunteer_capacity")
  maxRegistrations      Int              @default(0) @map("max_registrations")
  bannerImageKey        String?          @map("banner_image_key")
  coverImageKey         String?          @map("cover_image_key")
  isFeatured            Boolean          @default(false) @map("is_featured")
  visibility            EditionVisibility @default(PUBLIC)
  editionStatus         EditionStatus    @default(DRAFT) @map("edition_status")
  registrationEnabled   Boolean          @default(false) @map("registration_enabled")
  attendanceEnabled     Boolean          @default(false) @map("attendance_enabled")
  certificateEnabled    Boolean          @default(false) @map("certificate_enabled")
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")
  createdById           String?          @map("created_by_id") @db.Uuid
  updatedBy             String?          @map("updated_by") @db.Uuid
  deletedBy             String?          @map("deleted_by") @db.Uuid

  venueId               String?          @map("venue_id") @db.Uuid

  event         Event  @relation(fields: [eventId], references: [id])
  createdByUser User?  @relation(fields: [createdById], references: [id])
  venueRef      Venue? @relation(fields: [venueId], references: [id])
  shifts         EventShift[]
  applications   VolunteerApplication[]
  participations VolunteerParticipation[]
  certificates   VolunteerCertificate[]

  @@index([eventId])
  @@index([editionCode])
  @@index([slug])
  @@index([year])
  @@index([editionStatus])
  @@index([isFeatured])
  @@index([visibility])
  @@index([eventStarts])
  @@index([registrationOpens, registrationCloses])
  @@index([venueId])
  @@index([deletedAt])
  @@map("event_editions")
}

// ─── Venue ──────────────────────────────────────────────────────────────────

model Venue {
  id                   String      @id @default(uuid()) @db.Uuid
  venueCode            String      @unique @map("venue_code")
  name                 String
  description          String?     @db.Text
  address              String      @db.Text
  district             String?
  state                String
  country              String      @default("India")
  latitude             Float?
  longitude            Float?
  googleMapsUrl        String?     @map("google_maps_url")
  capacity             Int         @default(0)
  venueType            VenueType   @default(INDOOR) @map("venue_type")
  accessibilityDetails String?     @map("accessibility_details") @db.Text
  parkingInfo          String?     @map("parking_info") @db.Text
  emergencyContact     String?     @map("emergency_contact")
  venueStatus          VenueStatus @default(ACTIVE) @map("venue_status")
  version              Int         @default(1)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")
  createdBy            String?     @map("created_by") @db.Uuid
  updatedBy            String?     @map("updated_by") @db.Uuid
  deletedBy            String?     @map("deleted_by") @db.Uuid

  editions    EventEdition[]

  @@index([venueCode])
  @@index([venueStatus])
  @@index([venueType])
  @@index([deletedAt])
  @@map("venues")
}

// ─── Event Department ───────────────────────────────────────────────────────

model EventDepartment {
  id              String       @id @default(uuid()) @db.Uuid
  departmentCode  String       @unique @map("department_code")
  title           String
  description     String?      @db.Text
  color           String?      @db.VarChar(7)
  status          EntityStatus @default(ACTIVE)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid
  deletedBy       String?      @map("deleted_by") @db.Uuid

  roles        VolunteerRole[]
  applications VolunteerApplication[]

  @@index([departmentCode])
  @@index([status])
  @@index([deletedAt])
  @@map("event_departments")
}

// ─── Volunteer Role ─────────────────────────────────────────────────────────

model VolunteerRole {
  id              String       @id @default(uuid()) @db.Uuid
  roleCode        String       @unique @map("role_code")
  departmentId    String       @map("department_id") @db.Uuid
  title           String
  description     String?      @db.Text
  requiredSkills  String[]     @default([]) @map("required_skills")
  minVolunteers   Int          @default(1) @map("min_volunteers")
  maxVolunteers   Int          @default(10) @map("max_volunteers")
  priority        Int          @default(0)
  color           String?      @db.VarChar(7)
  iconAssetKey    String?      @map("icon_asset_key")
  status          EntityStatus @default(ACTIVE)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdBy       String?      @map("created_by") @db.Uuid
  updatedBy       String?      @map("updated_by") @db.Uuid
  deletedBy       String?      @map("deleted_by") @db.Uuid

  department   EventDepartment @relation(fields: [departmentId], references: [id])
  applications VolunteerApplication[]

  @@index([roleCode])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("volunteer_roles")
}

// ─── Event Shift ────────────────────────────────────────────────────────────

model EventShift {
  id          String      @id @default(uuid()) @db.Uuid
  shiftCode   String      @unique @map("shift_code")
  editionId   String      @map("edition_id") @db.Uuid
  name        String
  description String?     @db.Text
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  status      ShiftStatus @default(ACTIVE)
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  createdBy   String?     @map("created_by") @db.Uuid
  updatedBy   String?     @map("updated_by") @db.Uuid
  deletedBy   String?     @map("deleted_by") @db.Uuid

  edition      EventEdition @relation(fields: [editionId], references: [id])
  applications VolunteerApplication[]

  @@index([shiftCode])
  @@index([editionId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([deletedAt])
  @@map("event_shifts")
}

// ─── Volunteer Application ─────────────────────────────────────────────────

model VolunteerApplication {
  id                    String            @id @default(uuid()) @db.Uuid
  applicationCode       String            @unique @map("application_code")
  volunteerId           String            @map("volunteer_id") @db.Uuid
  editionId             String            @map("edition_id") @db.Uuid
  applicationStatus     ApplicationStatus @default(DRAFT) @map("application_status")
  motivation            String?           @db.Text
  relevantExperience    String?           @map("relevant_experience") @db.Text
  skills                String[]          @default([])
  languages             String[]          @default([])
  medicalConditions     String?           @map("medical_conditions") @db.Text
  emergencyContactName  String            @map("emergency_contact_name")
  emergencyContactPhone String            @map("emergency_contact_phone")
  availabilityNotes     String?           @map("availability_notes") @db.Text
  preferredShiftId      String?           @map("preferred_shift_id") @db.Uuid
  preferredDepartmentId String?           @map("preferred_department_id") @db.Uuid
  preferredRoleId       String?           @map("preferred_role_id") @db.Uuid
  expectedHours         Int?              @map("expected_hours")
  termsAccepted         Boolean           @default(false) @map("terms_accepted")
  adminRemarks          String?           @map("admin_remarks") @db.Text
  submittedAt           DateTime?         @map("submitted_at")
  reviewedAt            DateTime?         @map("reviewed_at")
  version               Int               @default(1)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  createdBy             String?           @map("created_by") @db.Uuid
  updatedBy             String?           @map("updated_by") @db.Uuid
  deletedBy             String?           @map("deleted_by") @db.Uuid

  volunteer             Volunteer            @relation(fields: [volunteerId], references: [id])
  edition               EventEdition         @relation(fields: [editionId], references: [id])
  preferredShift        EventShift?          @relation(fields: [preferredShiftId], references: [id])
  preferredDepartment   EventDepartment?     @relation(fields: [preferredDepartmentId], references: [id])
  preferredRole         VolunteerRole?       @relation(fields: [preferredRoleId], references: [id])
  participation         VolunteerParticipation?

  @@unique([volunteerId, editionId], map: "uq_volunteer_edition_application")
  @@index([applicationCode])
  @@index([volunteerId])
  @@index([editionId])
  @@index([applicationStatus])
  @@index([submittedAt])
  @@index([preferredDepartmentId])
  @@index([preferredRoleId])
  @@index([preferredShiftId])
  @@index([deletedAt])
  @@map("volunteer_applications")
}

// ─── Volunteer Participation (Simplified Event-Centric) ──────────────────

model VolunteerParticipation {
  id                    String              @id @default(uuid()) @db.Uuid
  participationCode     String              @unique @map("participation_code")
  applicationId         String              @unique @map("application_id") @db.Uuid
  volunteerId           String              @map("volunteer_id") @db.Uuid
  editionId             String              @map("edition_id") @db.Uuid
  participationStatus   ParticipationStatus @default(NOT_STARTED) @map("participation_status")
  startedAt             DateTime?           @map("started_at")
  completedAt           DateTime?           @map("completed_at")
  coordinatorRemarks    String?             @map("coordinator_remarks") @db.Text
  completionNotes       String?             @map("completion_notes") @db.Text
  certificateEligible   Boolean             @default(false) @map("certificate_eligible")
  version               Int                 @default(1)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  createdBy             String?             @map("created_by") @db.Uuid
  updatedBy             String?             @map("updated_by") @db.Uuid

  application VolunteerApplication @relation(fields: [applicationId], references: [id])
  volunteer   Volunteer            @relation(fields: [volunteerId], references: [id])
  edition     EventEdition         @relation(fields: [editionId], references: [id])
  certificates VolunteerCertificate[]

  @@unique([volunteerId, editionId], map: "uq_volunteer_edition_participation")
  @@index([participationCode])
  @@index([applicationId])
  @@index([volunteerId])
  @@index([editionId])
  @@index([participationStatus])
  @@index([startedAt])
  @@index([completedAt])
  @@index([certificateEligible])
  @@map("volunteer_participations")
}

// ─── Volunteer Certificate ───────────────────────────────────────────────

model VolunteerCertificate {
  id                 String            @id @default(uuid()) @db.Uuid
  certificateNumber  String            @unique @map("certificate_number")
  volunteerId        String            @map("volunteer_id") @db.Uuid
  participationId    String            @map("participation_id") @db.Uuid
  editionId          String            @map("edition_id") @db.Uuid
  certificateType    CertificateType   @default(PARTICIPATION) @map("certificate_type")
  certificateStatus  CertificateStatus @default(DRAFT) @map("certificate_status")
  issueDate          DateTime?         @map("issue_date")
  issuedBy           String?           @map("issued_by") @db.Uuid
  verificationToken  String            @unique @map("verification_token")
  bucketName         String?           @map("bucket_name")
  objectPath         String?           @map("object_path")
  publicUrl          String?           @map("public_url")
  contentType        String?           @map("content_type")
  fileSize           Int?              @map("file_size")
  checksum           String?
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  createdBy          String?           @map("created_by") @db.Uuid
  updatedBy          String?           @map("updated_by") @db.Uuid

  volunteer     Volunteer              @relation(fields: [volunteerId], references: [id])
  participation VolunteerParticipation  @relation(fields: [participationId], references: [id])
  edition       EventEdition           @relation(fields: [editionId], references: [id])

  @@index([certificateNumber])
  @@index([volunteerId])
  @@index([participationId])
  @@index([editionId])
  @@index([certificateType])
  @@index([certificateStatus])
  @@index([verificationToken])
  @@index([issueDate])
  @@index([deletedAt])
  @@map("volunteer_certificates")
}

// ─── Phase 9: Media & Digital Asset Management ──────────────────────────────

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum AssetStatus {
  ACTIVE
  ARCHIVED
  PROCESSING
  FAILED
}

enum DocumentCategory {
  PUBLICATION
  ANNUAL_REPORT
  POLICY
  CERTIFICATE
  PRESS_RELEASE
  DOWNLOAD
  OTHER
}

model MediaFolder {
  id          String   @id @default(uuid()) @db.Uuid
  folderCode  String   @unique @map("folder_code")
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(255)
  parentId    String?  @map("parent_id") @db.Uuid
  path        String   @db.Text
  depth       Int      @default(0)
  sortOrder   Int      @default(0) @map("sort_order")
  description String?  @db.Text
  visibility  MediaVisibility @default(PUBLIC)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@unique([parentId, slug], map: "uq_folder_parent_slug")
  @@index([folderCode])
  @@index([parentId])
  @@index([path])
  @@index([depth])
  @@index([visibility])
  @@index([deletedAt])
  @@map("media_folders")
}

model MediaAsset {
  id               String          @id @default(uuid()) @db.Uuid
  mediaCode        String          @unique @map("media_code")
  originalFilename String          @map("original_filename") @db.VarChar(500)
  storedFilename   String          @map("stored_filename") @db.VarChar(500)
  bucketName       String          @map("bucket_name") @db.VarChar(100)
  objectPath       String          @map("object_path") @db.Text
  publicUrl        String?         @map("public_url") @db.Text
  contentType      String          @map("content_type") @db.VarChar(100)
  extension        String          @db.VarChar(20)
  fileSize         Int             @map("file_size")
  mediaType        MediaType       @map("media_type")
  width            Int?
  height           Int?
  duration         Float?
  checksum         String          @db.VarChar(128)
  uploadedBy       String          @map("uploaded_by") @db.Uuid
  folderId         String?         @map("folder_id") @db.Uuid
  tags             String[]        @default([])
  description      String?         @db.Text
  altText          String?         @map("alt_text") @db.VarChar(500)
  visibility       MediaVisibility @default(PUBLIC)
  assetStatus      AssetStatus     @default(ACTIVE) @map("asset_status")
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  folder        MediaFolder?   @relation(fields: [folderId], references: [id])
  galleryImages GalleryImage[]
  document      Document?

  @@index([mediaCode])
  @@index([bucketName])
  @@index([contentType])
  @@index([mediaType])
  @@index([uploadedBy])
  @@index([folderId])
  @@index([visibility])
  @@index([assetStatus])
  @@index([checksum])
  @@index([deletedAt])
  @@index([tags])
  @@map("media_assets")
}

model GalleryAlbum {
  id            String          @id @default(uuid()) @db.Uuid
  albumCode     String          @unique @map("album_code")
  title         String          @db.VarChar(255)
  slug          String          @unique
  description   String?         @db.Text
  coverImageId  String?         @map("cover_image_id") @db.Uuid
  category      String?         @db.VarChar(100)
  tags          String[]        @default([])
  visibility    MediaVisibility @default(PUBLIC)
  isFeatured    Boolean         @default(false) @map("is_featured")
  sortOrder     Int             @default(0) @map("sort_order")
  eventEditionId String?        @map("event_edition_id") @db.Uuid
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  createdBy     String?         @map("created_by") @db.Uuid
  updatedBy     String?         @map("updated_by") @db.Uuid

  images GalleryImage[]

  @@index([albumCode])
  @@index([slug])
  @@index([category])
  @@index([visibility])
  @@index([isFeatured])
  @@index([eventEditionId])
  @@index([deletedAt])
  @@index([tags])
  @@map("gallery_albums")
}

model GalleryImage {
  id          String          @id @default(uuid()) @db.Uuid
  albumId     String          @map("album_id") @db.Uuid
  assetId     String          @map("asset_id") @db.Uuid
  caption     String?         @db.VarChar(500)
  sortOrder   Int             @default(0) @map("sort_order")
  isFeatured  Boolean         @default(false) @map("is_featured")
  visibility  MediaVisibility @default(PUBLIC)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  createdBy   String?         @map("created_by") @db.Uuid

  album GalleryAlbum @relation(fields: [albumId], references: [id])
  asset MediaAsset   @relation(fields: [assetId], references: [id])

  @@unique([albumId, assetId], map: "uq_album_asset")
  @@index([albumId])
  @@index([assetId])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("gallery_images")
}

model Document {
  id           String           @id @default(uuid()) @db.Uuid
  documentCode String           @unique @map("document_code")
  title        String           @db.VarChar(500)
  slug         String           @unique
  assetId      String           @unique @map("asset_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  summary      String?          @db.Text
  author       String?          @db.VarChar(255)
  publishDate  DateTime?        @map("publish_date")
  tags         String[]         @default([])
  visibility   MediaVisibility  @default(PUBLIC)
  isFeatured   Boolean          @default(false) @map("is_featured")
  downloadCount Int             @default(0) @map("download_count")
  sortOrder    Int              @default(0) @map("sort_order")
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  createdBy    String?          @map("created_by") @db.Uuid
  updatedBy    String?          @map("updated_by") @db.Uuid

  asset MediaAsset @relation(fields: [assetId], references: [id])

  @@index([documentCode])
  @@index([slug])
  @@index([assetId])
  @@index([category])
  @@index([visibility])
  @@index([isFeatured])
  @@index([publishDate])
  @@index([deletedAt])
  @@index([tags])
  @@map("documents")
}

// ─── Phase 10: Knowledge & Publications ──────────────────────────────────────

enum PublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
  WITHDRAWN
}

enum ContributorRole {
  PRIMARY_AUTHOR
  CO_AUTHOR
  EDITOR
  DESIGNER
  PHOTOGRAPHER
  CONTRIBUTOR
  TRANSLATOR
  REVIEWER
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
  WITHDRAWN
}

enum InteractionType {
  DOWNLOAD
  VIEW
  READ
}

model PublicationCategory {
  id            String   @id @default(uuid()) @db.Uuid
  categoryCode  String   @unique @map("category_code")
  name          String   @db.VarChar(255)
  slug          String   @unique
  description   String?  @db.Text
  parentId      String?  @map("parent_id") @db.Uuid
  iconUrl       String?  @map("icon_url") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid

  parent       PublicationCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     PublicationCategory[] @relation("CategoryTree")
  publications Publication[]

  @@index([categoryCode])
  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("publication_categories")
}

model Publication {
  id              String            @id @default(uuid()) @db.Uuid
  publicationCode String           @unique @map("publication_code")
  title           String           @db.VarChar(500)
  slug            String           @unique
  subtitle        String?          @db.VarChar(500)
  description     String?          @db.Text
  summary         String?          @db.Text
  categoryId      String           @map("category_id") @db.Uuid
  language        String           @default("en") @db.VarChar(10)
  isbn            String?          @db.VarChar(20)
  issn            String?          @db.VarChar(20)
  publicationDate DateTime?        @map("publication_date")
  releaseDate     DateTime?        @map("release_date")
  readingTime     Int?             @map("reading_time")
  keywords        String[]         @default([])
  status          PublicationStatus @default(DRAFT)
  visibility      MediaVisibility  @default(PUBLIC)
  isFeatured      Boolean          @default(false) @map("is_featured")
  coverImageId    String?          @map("cover_image_id") @db.Uuid
  pdfAssetId      String?          @map("pdf_asset_id") @db.Uuid
  thumbnailId     String?          @map("thumbnail_id") @db.Uuid
  seoTitle        String?          @map("seo_title") @db.VarChar(255)
  seoDescription  String?          @map("seo_description") @db.Text
  seoKeywords     String[]         @default([]) @map("seo_keywords")
  canonicalUrl    String?          @map("canonical_url") @db.Text
  downloadCount   Int              @default(0) @map("download_count")
  viewCount       Int              @default(0) @map("view_count")
  sortOrder       Int              @default(0) @map("sort_order")
  version         Int              @default(1)
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid

  category      PublicationCategory      @relation(fields: [categoryId], references: [id])
  editions      PublicationEdition[]
  contributors  PublicationContributor[]
  tags          PublicationTagLink[]
  articles      Article[]
  downloads     DownloadHistory[]
  readings      ReadingHistory[]

  @@index([publicationCode])
  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([publicationDate])
  @@index([releaseDate])
  @@index([language])
  @@index([downloadCount])
  @@index([viewCount])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([keywords])
  @@map("publications")
}

model PublicationEdition {
  id              String            @id @default(uuid()) @db.Uuid
  editionCode     String            @unique @map("edition_code")
  publicationId   String            @map("publication_id") @db.Uuid
  editionNumber   Int               @map("edition_number")
  volumeNumber    Int?              @map("volume_number")
  issueNumber     Int?              @map("issue_number")
  title           String?           @db.VarChar(500)
  description     String?           @db.Text
  publicationDate DateTime?         @map("publication_date")
  coverImageId    String?           @map("cover_image_id") @db.Uuid
  pdfAssetId      String?           @map("pdf_asset_id") @db.Uuid
  pageCount       Int?              @map("page_count")
  status          PublicationStatus @default(DRAFT)
  visibility      MediaVisibility   @default(PUBLIC)
  sortOrder       Int               @default(0) @map("sort_order")
  version         Int               @default(1)
  publishedAt     DateTime?         @map("published_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  createdBy       String?           @map("created_by") @db.Uuid
  updatedBy       String?           @map("updated_by") @db.Uuid

  publication Publication @relation(fields: [publicationId], references: [id])

  @@unique([publicationId, editionNumber], map: "uq_pub_edition")
  @@index([editionCode])
  @@index([publicationId])
  @@index([editionNumber])
  @@index([volumeNumber])
  @@index([issueNumber])
  @@index([status])
  @@index([publicationDate])
  @@index([deletedAt])
  @@map("publication_editions")
}

model PublicationContributor {
  id              String          @id @default(uuid()) @db.Uuid
  publicationId   String          @map("publication_id") @db.Uuid
  name            String          @db.VarChar(255)
  email           String?         @db.VarChar(255)
  bio             String?         @db.Text
  avatarUrl       String?         @map("avatar_url") @db.Text
  role            ContributorRole @default(CONTRIBUTOR)
  sortOrder       Int             @default(0) @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  publication Publication @relation(fields: [publicationId], references: [id])

  @@index([publicationId])
  @@index([name])
  @@index([role])
  @@index([deletedAt])
  @@map("publication_contributors")
}

model PublicationTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique
  usageCount Int     @default(0) @map("usage_count")
  createdAt DateTime @default(now()) @map("created_at")

  publications PublicationTagLink[]

  @@index([name])
  @@index([slug])
  @@index([usageCount])
  @@map("publication_tags")
}

model PublicationTagLink {
  publicationId String @map("publication_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  publication Publication    @relation(fields: [publicationId], references: [id])
  tag         PublicationTag @relation(fields: [tagId], references: [id])

  @@id([publicationId, tagId])
  @@index([publicationId])
  @@index([tagId])
  @@map("publication_tag_links")
}

model Article {
  id              String        @id @default(uuid()) @db.Uuid
  articleCode     String        @unique @map("article_code")
  publicationId   String?       @map("publication_id") @db.Uuid
  title           String        @db.VarChar(500)
  slug            String        @unique
  subtitle        String?       @db.VarChar(500)
  excerpt         String?       @db.Text
  content         String        @db.Text
  authorName      String        @map("author_name") @db.VarChar(255)
  authorBio       String?       @map("author_bio") @db.Text
  authorAvatarUrl String?       @map("author_avatar_url") @db.Text
  featuredImageId String?       @map("featured_image_id") @db.Uuid
  categories      String[]      @default([])
  tags            String[]      @default([])
  readingTime     Int?          @map("reading_time")
  status          ArticleStatus @default(DRAFT)
  visibility      MediaVisibility @default(PUBLIC)
  isFeatured      Boolean       @default(false) @map("is_featured")
  seoTitle        String?       @map("seo_title") @db.VarChar(255)
  seoDescription  String?       @map("seo_description") @db.Text
  seoKeywords     String[]      @default([]) @map("seo_keywords")
  viewCount       Int           @default(0) @map("view_count")
  sortOrder       Int           @default(0) @map("sort_order")
  version         Int           @default(1)
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid

  publication Publication? @relation(fields: [publicationId], references: [id])

  @@index([articleCode])
  @@index([slug])
  @@index([publicationId])
  @@index([authorName])
  @@index([status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([viewCount])
  @@index([deletedAt])
  @@index([categories])
  @@index([tags])
  @@map("articles")
}

model DownloadHistory {
  id            String          @id @default(uuid()) @db.Uuid
  publicationId String          @map("publication_id") @db.Uuid
  userId        String?         @map("user_id") @db.Uuid
  ipAddress     String?         @map("ip_address") @db.VarChar(45)
  userAgent     String?         @map("user_agent") @db.Text
  deviceType    String?         @map("device_type") @db.VarChar(50)
  interactionType InteractionType @default(DOWNLOAD) @map("interaction_type")
  createdAt     DateTime        @default(now()) @map("created_at")

  publication Publication @relation(fields: [publicationId], references: [id])

  @@index([publicationId])
  @@index([userId])
  @@index([interactionType])
  @@index([createdAt])
  @@map("download_history")
}

model ReadingHistory {
  id            String   @id @default(uuid()) @db.Uuid
  publicationId String   @map("publication_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  progress      Float    @default(0)
  lastReadAt    DateTime @default(now()) @map("last_read_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  publication Publication @relation(fields: [publicationId], references: [id])

  @@unique([publicationId, userId], map: "uq_reading_user")
  @@index([publicationId])
  @@index([userId])
  @@index([lastReadAt])
  @@map("reading_history")
}

model Archive {
  id            String   @id @default(uuid()) @db.Uuid
  archiveCode   String   @unique @map("archive_code")
  title         String   @db.VarChar(500)
  slug          String   @unique
  description   String?  @db.Text
  year          Int
  volumeNumber  Int?     @map("volume_number")
  issueNumber   Int?     @map("issue_number")
  categoryId    String?  @map("category_id") @db.Uuid
  coverImageId  String?  @map("cover_image_id") @db.Uuid
  pdfAssetId    String?  @map("pdf_asset_id") @db.Uuid
  collectionName String? @map("collection_name") @db.VarChar(255)
  visibility    MediaVisibility @default(PUBLIC)
  sortOrder     Int      @default(0) @map("sort_order")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid

  @@index([archiveCode])
  @@index([slug])
  @@index([year])
  @@index([volumeNumber])
  @@index([issueNumber])
  @@index([categoryId])
  @@index([collectionName])
  @@index([visibility])
  @@index([deletedAt])
  @@map("archives")
}
